            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/publications?limit=2&cursor=eyJsYXN0VXBkYXRlZEF0IjoiMjAyNi0wOS0wMlQxMTozMDowMFoiLCJsYXN0SWQiOiJwdWItMjAyNi0wMDIifQ==",
              "host": [
                "{{baseUrl}}"
