    {
      "name": "Publications Sync & Query",
      "description": "Endpoints to list, search, and synchronize publication metadata.",
      "item": [
        {
          "name": "Full Export (Unfiltered Publications)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/publications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "publications"
              ]
            },
            "description": "Retrieves all publication records in a deterministic order. Acting as a full export used for full recovery or initial imports."
          },
          "response": []
        },
        {
          "name": "Incremental Sync (updatedSince Filter)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/publications?updatedSince=2026-09-03T00:00:00Z",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "publications"
              ],
              "query": [
                {
                  "key": "updatedSince",
                  "value": "2026-09-03T00:00:00Z",
                  "description": "ISO 8601 UTC timestamp to retrieve changes made after this point."
                }
              ]
            },
            "description": "Delta-sync endpoint that retrieves only the publications created, updated, or tombstoned/withdrawn since the last watermark timestamp."
          },
          "response": []
        },
        {
          "name": "Pagination - Page 1 (Limit = 2)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/publications?limit=2",
