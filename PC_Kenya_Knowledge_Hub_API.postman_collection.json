              "path": [
                "v1",
                "publications"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "2",
                  "description": "Limit the output chunk size to test pagination boundaries."
                }
              ]
            },
            "description": "Retrieves the first two publications and provides an opaque `nextCursor` key inside the response body to fetch the next page."
          },
          "response": []
        },
